{
  "layoutVersion": "2.4.1",
  "siteTitle": "Athletics Performance OS",
  "subtitle": "18m30への練習計画と実施記録",
  "theme": {
    "accent": "#48e2f2",
    "accentSecondary": "#c9ff4a",
    "surface": "#0a1620",
    "background": "#050b12",
    "text": "#f7fafc",
    "muted": "#8ea5b4"
  },
  "trainingView": {
    "defaultMode": "day",
    "modes": ["day", "week", "month"],
    "showIntensity10": true,
    "menuIntensityBands": {
      "low": {"min": 1, "max": 3, "color": "#48e2f2"},
      "medium": {"min": 4, "max": 7, "color": "#ffd166"},
      "high": {"min": 8, "max": 10, "color": "#ff6b6b"}
    },
    "showNextCompetition": true,
    "recordEntry": {
      "visible": true,
      "voice": true,
      "manual": true,
      "requiresReviewBeforeSave": true,
      "storeRawAudio": false,
      "writeEnabled": false
    }
  },
  "sections": [
    {"id":"today","type":"today","title":"今日のトレーニング"},
    {"id":"week","type":"week","title":"今週のトレーニング"},
    {"id":"month","type":"month","title":"月間トレーニング"},
    {"id":"history","type":"history","title":"最近の実施記録"},
    {"id":"exercise-library","type":"exerciseLibrary","title":"種目ライブラリ"},
    {"id":"measurements","type":"measurements","title":"計測基準・記録"}
  ],
  "secondarySections": ["history", "exerciseLibrary", "measurements"]
}
