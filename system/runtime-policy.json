{
  "schemaVersion": "1.0.0",
  "system": "Athletics Performance OS",
  "policyVersion": "2026-08-24-r2",
  "canonicalEntities": [
    "overview",
    "settings",
    "sportProfiles",
    "governanceRules",
    "trainingRules",
    "exercises",
    "cycles",
    "events",
    "sessions",
    "menuItems",
    "executions",
    "reviews",
    "measurements",
    "media",
    "proposals",
    "changes",
    "batches",
    "idLedger",
    "recurrenceRules",
    "migrationAudit",
    "dictionary",
    "options"
  ],
  "deprecatedEntityAliases": {
    "kpis": "measurements"
  },
  "maintenance": {
    "sourceRoot": "system",
    "siteSourceRoot": "site",
    "workflow": "READ -> PREVIEW -> EXPLICIT_APPROVAL -> APPLY -> DEPLOYMENT_VERIFY -> READ_BACK",
    "capabilitiesAction": "getMaintenanceCapabilities",
    "readAction": "maintenanceRead",
    "previewAction": "maintenancePreview",
    "applyAction": "maintenanceApply"
  },
  "siteApprovalInteraction": {
    "previewExecutionRequired": true,
    "previewPresentationRequired": false,
    "inlineApprovalIntentAllowed": true,
    "inlineApprovalScope": "NON_DESTRUCTIVE_SITE_CHANGES_ONLY",
    "inlineApprovalRequiresExplicitPreviewWaiverAndApplyVerb": true,
    "exactPreviewContentRequired": true,
    "destructiveChangesRequirePostPreviewApproval": true
  },
  "canonicalDataApprovalInteraction": {
    "previewExecutionRequired": true,
    "previewPresentationRequired": false,
    "inlineApprovalIntentAllowed": true,
    "inlineApprovalOperations": ["INSERT", "UPDATE", "UPSERT"],
    "inlineApprovalRequiresExplicitPreviewWaiverAndApplyVerb": true,
    "exactPreviewContentRequired": true,
    "archiveDeleteRollbackBackupRequirePostPreviewApproval": true
  },
  "safety": {
    "finalApprover": "山下祐樹",
    "previewRequired": true,
    "approvalHashRequired": true,
    "nonceRequired": true,
    "writeAutoRetry": false,
    "verifyAfterApply": true,
    "secretsInChat": false,
    "physicalDeleteDefault": false
  },
  "payload": {
    "gptActionRequestResponseMaxChars": 100000,
    "contextBudgetBytes": 60000,
    "sourceReadChunkChars": 30000,
    "sourcePreviewMaxFiles": 8
  },
  "notes": [
    "This runtime policy may refine maintenance behavior but may not weaken MyGPT base safety rules.",
    "GPT public Action contract is limited to 30 operations.",
    "WORKBOOK_STATUS must not be promoted to PRODUCTION_READY until all live acceptance tests pass."
  ],
  "runtimeVersions": {
    "worker": "1.4.22",
    "appsScriptApi": "1.2.1",
    "canonicalSchema": "1.1.0",
    "openapi": "2.5.2",
    "myGptInstructions": "2.5.4-compact-30-actions"
  },
  "deployment": {
    "worker": "GitHub Actions -> cloudflare/wrangler-action@v3 -> Wrangler v4 -> Cloudflare Worker",
    "appsScript": "GitHub Actions -> deploy_apps_script.py -> Apps Script API getContent/updateContent -> version -> deployment update",
    "verifyAfterDeploy": true
  }
}
